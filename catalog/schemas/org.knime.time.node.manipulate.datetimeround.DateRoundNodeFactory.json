{
  "id" : "org.knime.time.node.manipulate.datetimeround.DateRoundNodeFactory",
  "available" : true,
  "schemaKind" : "annotations",
  "schema" : {
    "class" : "org.knime.time.node.manipulate.datetimeround.DateRoundNodeSettings",
    "fields" : [ {
      "field" : "m_columnFilter",
      "configKey" : "columnFilter",
      "title" : "Date&time columns",
      "description" : "The date&amp;time columns whose values are shifted.",
      "advanced" : false,
      "type" : "unknown",
      "javaType" : "org.knime.node.parameters.widget.choices.filter.ColumnFilter",
      "choicesSource" : {
        "provider" : "org.knime.time.util.DateTimeUtils$DateColumnProvider",
        "kind" : "columns",
        "note" : "варианты зависят от входной таблицы"
      },
      "choicesNote" : "варианты появятся, когда к узлу подключена входная таблица"
    }, {
      "field" : "m_dateRoundingStrategy",
      "configKey" : "dateRoundingStrategy",
      "title" : "Round to",
      "description" : "The rounding strategy to apply, either round to the first or last value of the chosen rounding precision.\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "FIRST",
        "label" : "First"
      }, {
        "value" : "LAST",
        "label" : "Last"
      } ],
      "default" : "FIRST"
    }, {
      "field" : "m_dayOrWeekDay",
      "configKey" : "dayOrWeekDay",
      "title" : "Exclude weekends",
      "description" : "Option to exclude weekends from the rounding. A weekend is defined as Saturday and Sunday.\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "DAY",
        "label" : "Day"
      }, {
        "value" : "WEEKDAY",
        "label" : "Weekday"
      } ],
      "default" : "DAY"
    }, {
      "field" : "m_shiftMode",
      "configKey" : "shiftMode",
      "title" : "Additional shift",
      "description" : "Option to shift the date to the previous or next date in the chosen resolution.\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "PREVIOUS",
        "label" : "Previous"
      }, {
        "value" : "THIS",
        "label" : "This"
      }, {
        "value" : "NEXT",
        "label" : "Next"
      } ],
      "default" : "THIS"
    }, {
      "field" : "m_dateRoundingPrecision",
      "configKey" : "dateRoundingPrecision",
      "title" : "Rounding precision",
      "description" : "The rounding precision. The date will be rounded to the first or last value of the chosen precision.\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "DECADE",
        "label" : "Decade"
      }, {
        "value" : "YEAR",
        "label" : "Year"
      }, {
        "value" : "QUARTER",
        "label" : "Quarter"
      }, {
        "value" : "MONTH",
        "label" : "Month"
      }, {
        "value" : "WEEK",
        "label" : "Week"
      } ],
      "default" : "MONTH"
    }, {
      "field" : "m_replaceOrAppend",
      "configKey" : "replaceOrAppend",
      "title" : "Output columns",
      "description" : "Depending on this setting, the output columns will either replace the modified columns, or be appended to the table with a suffix.\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "REPLACE",
        "label" : "Replace"
      }, {
        "value" : "APPEND",
        "label" : "Append with suffix"
      } ],
      "default" : "REPLACE"
    }, {
      "field" : "m_outputColumnSuffix",
      "configKey" : "outputColumnSuffix",
      "title" : "Output column suffix",
      "description" : "The suffix to append to the column names of the new columns.",
      "advanced" : false,
      "type" : "string",
      "default" : " (Rounded)"
    } ]
  },
  "tier" : "experimental"
}