{
  "id" : "org.knime.base.node.preproc.table.updater.TableUpdaterNodeFactory",
  "available" : true,
  "schemaKind" : "annotations",
  "schema" : {
    "class" : "org.knime.base.node.preproc.table.updater.TableUpdaterNodeSettings",
    "fields" : [ {
      "field" : "m_unmatchedColumnsHandling",
      "configKey" : "unmatchedColumnsHandling",
      "title" : "Columns missing in input table",
      "description" : "Controls how to deal with columns in the update table that are not part of the input table.",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "IGNORE",
        "label" : "Ignore"
      }, {
        "value" : "APPEND",
        "label" : "Append"
      }, {
        "value" : "FAIL",
        "label" : "Fail"
      } ],
      "default" : "IGNORE"
    }, {
      "field" : "m_unmatchedRowsHandling",
      "configKey" : "unmatchedRowsHandling",
      "title" : "Rows missing in input table",
      "description" : "Controls how to deal with rows in the update table whose RowIDs don't occur in the input table.",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "IGNORE",
        "label" : "Ignore"
      }, {
        "value" : "APPEND",
        "label" : "Append"
      }, {
        "value" : "FAIL",
        "label" : "Fail"
      } ],
      "default" : "IGNORE"
    }, {
      "field" : "m_performUpdateWithMissingValues",
      "configKey" : "performUpdateWithMissingValues",
      "title" : "Perform update with missing values",
      "description" : "If unchecked, the values in the input table remain unchanged if the corresponding value in the update table is missing. If checked, all values are updated.",
      "advanced" : false,
      "type" : "boolean",
      "default" : true
    } ]
  },
  "tier" : "experimental"
}