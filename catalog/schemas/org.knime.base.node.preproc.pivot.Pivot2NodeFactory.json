      "fields" : [ {
        "field" : "m_columnNamePolicy",
        "configKey" : "columnNamePolicy",
        "title" : "Column naming",
        "description" : "The name of the resulting aggregation column(s) depends on the\nselected naming schema.\n<ul>\n    <li>Keep original name(s):\n    Keeps the original column names.\n    Note that you can use all aggregation columns only once with\n    this column naming option to prevent duplicate column names.\n    </li>\n    <li>Aggregation method (column name):\n    Uses the aggregation method first and appends the column name\n    in brackets\n    </li>\n    <li>Column name (aggregation method):\n    Uses the column name first and appends the aggregation method\n    in brackets\n    </li>\n</ul>\nAll aggregation methods get a * appended if the missing value option\nis not ticked in the aggregation settings in order to distinguish\nbetween columns that considered missing values in the aggregation\nprocess and columns that do not.\n",
        "advanced" : false,
        "type" : "enum",
        "choices" : [ {
          "value" : "KEEP_ORIGINAL_NAME",
          "label" : "Keep original name(s)"
        }, {
          "value" : "AGGREGATION_METHOD_COLUMN_NAME",
          "label" : "Aggregation method (column name)"
        }, {
          "value" : "COLUMN_NAME_AGGREGATION_METHOD",
          "label" : "Column name (aggregation method)"
        } ],
        "default" : "AGGREGATION_METHOD_COLUMN_NAME"
      } ]
    }, {
      "field" : "m_globalAggregationMethodParameters",
      "configKey" : "globalAggregationMethodParameters",
      "title" : "GlobalAggregationMethodParameters",
      "description" : "",
      "advanced" : false,
