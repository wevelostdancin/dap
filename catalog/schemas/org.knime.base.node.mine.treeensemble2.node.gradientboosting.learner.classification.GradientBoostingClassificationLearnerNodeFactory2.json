      "field" : "m_maxTreeDepth",
      "configKey" : "maxTreeDepth",
      "title" : "Limit number of levels (tree depth)",
      "description" : "Limit the maximal number of tree levels. When disabled the tree depth is unbounded.\nFor instance, a value of 1 would only split the (single) root node resulting in a decision stump.\nFor gradient boosted trees usually a depth in the range 4 to 10 is sufficient. Larger trees will\nquickly lead to overfitting.\n",
      "advanced" : false,
      "type" : "integer",
      "nullable" : true,
      "default" : null,
      "optional" : true
    }, {
      "field" : "m_columnSamplingMode",
      "configKey" : "columnSamplingMode",
      "title" : "Attribute sampling (columns)",
      "description" : "Defines the sampling of attributes to learn an individual tree. This can either be a function based on the\nnumber of attributes (linear fraction or square root) or some absolute value. The latter can be used in\nconjunction with flow variables to inject some other value derived from the number of attributes (e.g.\nBreiman suggests starting with the square root of the number of attributes but also to try to double or\nhalf that number).\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "NONE",
        "label" : "All columns"
      }, {
        "value" : "SQUARE_ROOT",
        "label" : "Square root"
      }, {
        "value" : "LINEAR",
        "label" : "Linear fraction"
      }, {
        "value" : "ABSOLUTE",
        "label" : "Absolute number"
      } ],
      "default" : "NONE"
    }, {
      "field" : "m_gradientBoostingParams",
      "configKey" : "gradientBoostingParams",
      "title" : "GradientBoostingParams",
      "description" : "",
      "advanced" : false,
      "type" : "object",
      "fields" : [ {
        "field" : "m_learningRate",
        "configKey" : "learningRate",
        "title" : "Learning rate",
        "description" : "The learning rate influences how much influence a single model has on the ensemble result.\nUsually a value of 0.1 is a good starting point but the best learning rate also depends on the\nnumber of models. The more models the ensemble contains the lower the learning rate has to be.\n",
        "advanced" : false,
        "type" : "number",
        "default" : 0.1,
        "step" : 0.05
      }, {
        "field" : "m_alpha",
        "configKey" : "alphaFraction",
        "title" : "Alpha",
        "description" : "",
        "advanced" : false,
        "type" : "number",
        "default" : 0.95,
        "step" : 0.05
      } ]
    }, {
      "field" : "m_attributeReuse",
      "configKey" : "attributeReuse",
      "title" : "Attribute selection",
      "description" : "<p>\n  <i>Use the same set of attributes for each tree</i>\n  means that the attributes are sampled once for each tree\n  and this sample is then used to construct the tree.\n</p>\n<p>\n  <i>Use a different set of attributes for each tree node</i>\n  samples a different set of candidate attributes in each of the tree nodes\n  from which the optimal one is chosen to perform the split.\n  This is the option used in random forests.\n</p>\n",
      "advanced" : false,
      "type" : "enum",
      "choices" : [ {
        "value" : "SAME_FOR_TREE",
        "label" : "Use same set of attributes for entire tree"
      }, {
        "value" : "DIFFERENT_FOR_EACH_NODE",
        "label" : "Use different set of attributes for each tree node"
      } ],
      "default" : "SAME_FOR_TREE"
    }, {
      "field" : "m_targetColumn",
