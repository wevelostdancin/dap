{
  "id" : "org.knime.json.node.container.output.table.ContainerTableOutputNodeFactory",
  "available" : true,
  "schemaKind" : "annotations",
  "schema" : {
    "class" : "org.knime.json.node.container.output.table.ContainerTableOutputNodeParameters",
    "fields" : [ {
      "field" : "m_parameterName",
      "configKey" : "parameterName",
      "title" : "Parameter name",
      "description" : "A name for the output parameter (preferably unique). This name is exposed in the REST interface and in the\nCall Workflow (Table Based) node. It must start with a letter, followed by letters and digits and single\nminus signs or dashes and must end with a letter.\nPattern: <tt>^[a-zA-Z](?:[-_]?[a-zA-Z0-9]+)*(?&lt;![0-9])$</tt>\n",
      "advanced" : false,
      "type" : "string",
      "default" : "table-output"
    }, {
      "field" : "m_useFullyQualifiedName",
      "configKey" : "useFullyQualifiedName",
      "title" : "Append unique ID to parameter name",
      "description" : "If checked, the name set above will be amended by the node's ID \"{Parameter Name}-{Relative node ID}\" to\nguarantee unique parameter names. Usually it's a good idea to have this box <i>not</i> checked and instead\nmake sure to use meaningful and unique names in all container nodes present in a workflow.\n",
      "advanced" : false,
      "type" : "boolean",
      "default" : false
    }, {
      "field" : "m_description",
      "configKey" : "description",
      "title" : "Description",
      "description" : "The description for the output parameter. It is currently <i>not</i> shown in the API specification of the REST interface but it's used for example when using this workflow as a tool for an AI Agent or when\nextracting the workflow summary.\n",
      "advanced" : false,
      "type" : "string",
      "default" : ""
    }, {
      "field" : "m_outputPathOrUrl",
      "configKey" : "outputPathOrUrl",
      "title" : "OutputPathOrUrl",
      "description" : "",
      "advanced" : false,
      "type" : "string",
      "default" : null
    }, {
      "field" : "m_useEntireTable",
      "configKey" : "useEntireTable",
      "title" : "UseEntireTable",
      "description" : "",
      "advanced" : false,
      "type" : "boolean",
      "default" : true
    }, {
      "field" : "m_numberOfRows",
      "configKey" : "numberOfRows",
      "title" : "NumberOfRows",
      "description" : "",
      "advanced" : false,
      "type" : "integer",
      "default" : 10
    }, {
      "field" : "m_omitTableSpec",
      "configKey" : "omitTableSpec",
      "title" : "OmitTableSpec",
      "description" : "",
      "advanced" : false,
      "type" : "boolean",
      "default" : false
    }, {
      "field" : "m_templateTableKey",
      "configKey" : "exampleOutput",
      "title" : "TemplateTableKey",
      "description" : "",
      "advanced" : false,
      "type" : "string",
      "default" : "{\"table-spec\":[{\"column-string\":\"string\"},{\"column-int\":\"int\"},{\"column-double\":\"double\"},{\"column-long\":\"long\"},{\"column-boolean\":\"boolean\"},{\"column-localdate\":\"localdate\"},{\"column-localdatetime\":\"localdatetime\"},{\"column-zoneddatetime\":\"zoneddatetime\"}],\"table-data\":[[\"value1\",1,1.5,1000,true,\"2018-03-27\",\"2018-03-27T08:30:45.111\",\"2018-03-27T08:30:45.111+01:00[Europe/Paris]\"],[\"value2\",2,2.5,2000,false,\"2018-03-28\",\"2018-03-28T08:30:45.111\",\"2018-03-28T08:30:45.111+01:00[Europe/Paris]\"]]}"
    } ]
  },
  "tier" : "experimental"
}