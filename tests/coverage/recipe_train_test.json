{
  "format": "dap-coverage-scenario/1",
  "cases": [
    {
      "task": "C15",
      "title": "Train/test split with a split flag and two row_filter branches",
      "kind": "recipe",
      "requires": [],
      "workflow": {
        "id": "cov-recipe-train-test",
        "nodes": [
          {
            "id": "src",
            "type": "csv_reader",
            "config": {
              "dataset": "P2"
            }
          },
          {
            "id": "q",
            "type": "sql_query",
            "config": {
              "sql": "SELECT *, ((id * 37) % 10) < 7 AS is_train FROM src",
              "inputs": [
                "src"
              ]
            }
          },
          {
            "id": "train",
            "type": "row_filter",
            "config": {
              "where": [
                {
                  "column": "is_train",
                  "op": "eq",
                  "value": true
                }
              ]
            }
          },
          {
            "id": "test",
            "type": "row_filter",
            "config": {
              "where": [
                {
                  "column": "is_train",
                  "op": "eq",
                  "value": false
                }
              ]
            }
          },
          {
            "id": "train_cols",
            "type": "column_filter",
            "config": {
              "exclude": [
                "is_train"
              ]
            }
          },
          {
            "id": "test_cols",
            "type": "column_filter",
            "config": {
              "exclude": [
                "is_train"
              ]
            }
          },
          {
            "id": "all_rows",
            "type": "concatenate",
            "config": {
              "mode": "name"
            }
          }
        ],
        "edges": [
          {
            "from": "src",
            "to": "q"
          },
          {
            "from": "q",
            "to": "train"
          },
          {
            "from": "q",
            "to": "test"
          },
          {
            "from": "train",
            "to": "train_cols"
          },
          {
            "from": "test",
            "to": "test_cols"
          },
          {
            "from": "train_cols",
            "to": "all_rows",
            "toPort": 0
          },
          {
            "from": "test_cols",
            "to": "all_rows",
            "toPort": 1
          }
        ]
      },
      "checks": [
