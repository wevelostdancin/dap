{
  "format": "dap-coverage-scenario/1",
  "cases": [
    {
      "task": "B1",
      "title": "Filter rows with dap.row_filter",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-filter",
        "nodes": [
          {
            "id": "src",
            "type": "csv_reader",
            "config": {
              "dataset": "P2"
            }
          },
          {
            "id": "f",
            "type": "row_filter",
            "config": {
              "where": [
                {
                  "column": "score",
                  "op": "ge",
                  "value": 3
                }
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "src",
            "to": "f"
          }
        ]
      },
      "checks": [
        {
          "node": "f",
          "kind": "expect",
          "rows": 4,
          "columns": [
            {
              "name": "id",
              "type": "Number (Integer)"
            },
            {
              "name": "name",
              "type": "String"
            },
            {
              "name": "score",
              "type": "Number (Float)"
            },
            {
              "name": "category",
              "type": "String"
            }
          ],
          "data": [
            [
              3,
              "gamma",
              3,
              "A"
            ],
            [
              4,
              "delta",
              4,
              "C"
            ],
            [
              3,
              "gamma",
              3,
              "A"
            ],
            [
              5,
              "epsilon",
              5,
              "B"
            ]
          ],
          "order": "unordered"
        }
      ]
    },
    {
      "task": "B2",
      "title": "Select, rename and reorder columns",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-columns",
        "nodes": [
          {
            "id": "src",
            "type": "csv_reader",
            "config": {
              "dataset": "P2"
            }
          },
          {
            "id": "cf",
            "type": "column_filter",
            "config": {
              "include": [
                "id",
                "name",
                "score"
              ]
            }
          },
          {
            "id": "rn",
            "type": "column_renamer",
            "config": {
              "renames": [
                {
                  "from": "id",
                  "to": "key"
                }
              ]
            }
          },
          {
            "id": "cr",
            "type": "column_resorter",
            "config": {
              "columns": [
                "name",
                "key",
                "score"
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "src",
            "to": "cf"
          },
          {
            "from": "cf",
            "to": "rn"
          },
          {
            "from": "rn",
            "to": "cr"
          }
        ]
      },
      "checks": [
        {
          "node": "cr",
          "kind": "expect",
          "rows": 6,
          "columns": [
            {
              "name": "name",
              "type": "String"
            },
            {
              "name": "key",
              "type": "Number (Integer)"
            },
            {
              "name": "score",
              "type": "Number (Float)"
            }
          ],
          "data": [
            [
              "alpha",
              1,
              1
            ],
            [
              "beta",
              2,
              2
            ],
            [
              "gamma",
              3,
              3
            ],
            [
              "delta",
              4,
              4
            ],
            [
              "gamma",
              3,
              3
            ],
            [
              "epsilon",
              5,
              5
            ]
          ],
          "order": "ordered"
        }
      ]
    },
