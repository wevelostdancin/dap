    {
      "task": "B7",
      "title": "Drop outliers with IQR fences",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-outlier-filter",
        "nodes": [
          {
            "id": "src",
            "type": "csv_reader",
            "config": {
              "dataset": "IRIS"
            }
          },
          {
            "id": "o",
            "type": "outlier_filter",
            "config": {
              "columns": [
                "sepal_width"
              ],
              "method": "iqr",
              "threshold": 1.5
            }
          },
          {
            "id": "g",
            "type": "group_by",
            "config": {
              "keys": [
                "species"
              ],
              "aggregations": [
                {
                  "column": "sepal_width",
                  "fn": "count"
                }
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "src",
            "to": "o"
          },
          {
            "from": "o",
            "to": "g"
          }
        ]
      },
      "checks": [
        {
          "node": "g",
          "kind": "expect",
          "rows": 3,
          "columns": [
            {
              "name": "species",
              "type": "String"
            },
            {
              "name": "Count(sepal_width)",
              "type": "Number (Integer)"
            }
          ],
          "data": [
            [
              "setosa",
              47
            ],
            [
              "versicolor",
              49
            ],
            [
              "virginica",
              50
            ]
          ],
          "order": "unordered"
        }
      ]
    },
