    {
      "task": "B4",
      "title": "Fill missing values with a constant",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-missing",
        "nodes": [
          {
            "id": "src",
            "type": "csv_reader",
            "config": {
              "dataset": "WORLDBANK_COUNTRIES"
            }
          },
          {
            "id": "m",
            "type": "missing_value",
            "config": {
              "rules": [
                {
                  "column": "Currency Unit",
                  "method": "constant",
                  "value": "UNKNOWN"
                }
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "src",
            "to": "m"
          }
        ]
      },
      "checks": [
        {
          "node": "m",
          "kind": "expect_profile",
          "rows": 265,
          "columns": [
            {
              "name": "Currency Unit",
              "type": "String",
              "missing": 0,
              "distinct": 152
            }
          ]
        }
      ]
    },
