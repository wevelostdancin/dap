            }
          },
          {
            "id": "fm",
            "type": "date_time",
            "config": {
              "column": "date",
              "output": "date_str",
              "op": "format",
              "format": "%Y/%m/%d"
            }
          }
        ],
        "edges": [
          {
            "from": "dr",
            "to": "ex"
          },
          {
            "from": "dr",
            "to": "fm"
          }
        ]
      },
      "checks": [
        {
          "node": "ex",
          "kind": "expect",
          "rows": 3,
          "columns": [
            {
              "name": "date",
              "type": "Date&Time (Timestamp)"
            },
            {
              "name": "month",
              "type": "Number (Integer)"
            }
          ],
          "data": [
            [
              "2026-01-01T00:00",
              1
            ],
            [
