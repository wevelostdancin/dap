{
  "format": "dap-coverage-scenario/1",
  "cases": [
    {
      "task": "F1",
      "title": "Resample a timestamp column into buckets",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-resample",
        "nodes": [
          {
            "id": "dr",
            "type": "date_range",
            "config": {
              "start": "2026-01-01",
              "end": "2026-01-03",
              "step": "12 hours"
            }
          },
          {
            "id": "r",
            "type": "resample",
            "config": {
              "timeColumn": "date",
              "every": "1 day",
              "aggregations": [
                {
                  "column": "date",
                  "fn": "count",
                  "output": "n"
                }
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "dr",
            "to": "r"
          }
        ]
      },
      "checks": [
        {
          "node": "r",
          "kind": "expect",
          "rows": 3,
          "columns": [
            {
              "name": "date",
              "type": "Date&Time (Timestamp)"
            },
            {
              "name": "n",
              "type": "Number (Integer)"
            }
          ],
          "data": [
            [
              "2026-01-01T00:00",
              2
            ],
            [
              "2026-01-02T00:00",
              2
            ],
            [
              "2026-01-03T00:00",
              1
            ]
          ],
          "order": "ordered"
        }
      ]
    },
    {
      "task": "F2",
      "title": "Rolling window aggregate",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-rolling",
        "nodes": [
          {
            "id": "src",
            "type": "csv_reader",
            "config": {
              "dataset": "P2"
            }
          },
          {
            "id": "r",
            "type": "rolling",
            "config": {
              "column": "score",
              "output": "score_ma",
              "window": 2,
              "fn": "mean",
              "orderBy": [
                {
                  "column": "id",
                  "direction": "asc"
                }
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "src",
            "to": "r"
          }
        ]
      },
      "checks": [
        {
          "node": "r",
          "kind": "expect",
          "rows": 6,
          "columns": [
            {
              "name": "id",
              "type": "Number (Integer)"
            },
            {
              "name": "name",
              "type": "String"
            },
            {
              "name": "score",
              "type": "Number (Float)"
            },
            {
              "name": "category",
              "type": "String"
            },
            {
              "name": "score_ma",
              "type": "Number (Float)"
            }
          ],
          "data": [
            [
              1,
              "alpha",
