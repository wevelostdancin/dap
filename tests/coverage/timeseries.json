    {
      "task": "F5",
      "title": "Extract and format parts of a timestamp",
      "kind": "node",
      "requires": [],
      "workflow": {
        "id": "cov-date-time",
        "nodes": [
          {
            "id": "dr",
            "type": "date_range",
            "config": {
              "start": "2026-01-01",
              "end": "2026-01-03",
              "step": "1 day"
            }
          },
          {
            "id": "ex",
            "type": "date_time",
            "config": {
              "column": "date",
