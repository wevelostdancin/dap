{
  "id": "wf-n2-excel-source",
  "title": "Native-only: Excel Reader on the exported iris workbook",
  "rationale": "The workbook holds the same values as the CSV fixture, so the result must match wf-n1.",
  "kind": "native-only",
  "oracle_skip_reason": "file-based readers fail in the oracle: 'Execute failed: Workflow context required.'",
  "nodes": [
    {
      "id": "src",
      "type": "excel_reader",
      "config": {
        "dataset": "IRIS"
      }
    },
    {
      "id": "g",
      "type": "group_by",
      "config": {
        "keys": [
          "species"
        ],
        "aggregations": [
          {
            "column": "sepal_length",
            "fn": "mean"
          }
        ]
      }
    },
    {
      "id": "sort",
      "type": "sorter",
      "config": {
        "keys": [
          {
            "column": "species",
            "direction": "asc"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "src",
      "to": "g"
    },
    {
      "from": "g",
      "to": "sort"
    }
  ],
  "checks": [
    {
      "node": "g",
      "kind": "equivalent",
      "workflow": "wf-n1-csv-source",
      "node_ref": "g"
    },
    {
      "node": "sort",
      "kind": "table",
      "limit": 10,
      "order": "ordered"
    }
  ]
}
