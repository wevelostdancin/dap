{
  "id": "wf-09-empty-result",
  "title": "Iris: filter that matches nothing",
  "rationale": "An empty result must keep the schema and report rows=0 without an error.",
  "kind": "dual-run",
  "nodes": [
    {
      "id": "src",
      "type": "table_source",
      "config": {
        "dataset": "IRIS"
      }
    },
    {
      "id": "filter",
      "type": "row_filter",
      "config": {
        "where": [
          {
            "column": "species",
            "op": "eq",
            "value": "no-such-species"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "src",
      "to": "filter"
    }
  ],
  "checks": [
    {
      "node": "filter",
      "kind": "table",
      "limit": 50,
      "order": "unordered"
    },
    {
      "node": "filter",
      "kind": "profile"
    }
  ]
}
