{
  "id": "wf-10-iris-pipeline",
  "title": "Iris: derivations, predicate on a derived column, aggregate",
  "rationale": "Five-node chain: formula -> filter on its output -> column pruning -> grouping -> sort (native-only, formula blocker).",
  "kind": "native",
  "nodes": [
    {
      "id": "src",
      "type": "table_source",
      "config": {
        "dataset": "IRIS"
      }
    },
    {
      "id": "math",
      "type": "math_formula",
      "config": {
        "outputs": [
          {
            "name": "sepal_total",
            "expression": "sepal_length + sepal_width"
          }
        ]
      }
    },
    {
      "id": "filter",
      "type": "row_filter",
      "config": {
        "where": [
          {
            "column": "sepal_total",
            "op": "gt",
            "value": 8
          }
        ]
      }
    },
    {
      "id": "cols",
      "type": "column_filter",
      "config": {
        "exclude": [
          "sepal_length",
          "sepal_width",
          "petal_length",
          "petal_width"
        ]
      }
    },
    {
      "id": "g",
      "type": "group_by",
      "config": {
        "keys": [
          "species"
        ],
        "aggregations": [
          {
            "column": "sepal_total",
            "fn": "mean"
          }
        ]
      }
    },
    {
      "id": "sort",
      "type": "sorter",
      "config": {
        "keys": [
          {
            "column": "species",
            "direction": "asc"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "src",
      "to": "math"
    },
    {
      "from": "math",
      "to": "filter"
    },
    {
      "from": "filter",
      "to": "cols"
    },
    {
      "from": "cols",
      "to": "g"
    },
    {
      "from": "g",
      "to": "sort"
    }
  ],
  "checks": [
    {
      "node": "cols",
      "kind": "expect_profile",
      "rows": 122,
      "columns": [
        "species",
        "sepal_total"
      ]
    },
    {
      "node": "sort",
      "kind": "expect",
      "rows": 3,
      "columns": [
        {
          "name": "species",
          "type": "String"
        },
        {
          "name": "Mean(sepal_total)",
          "type": "Number (Float)"
        }
      ],
      "data": [
        [
          "setosa",
          8.815625
        ],
        [
          "versicolor",
          8.941463414634146
        ],
        [
          "virginica",
          9.606122448979592
        ]
      ],
      "order": "ordered"
    }
  ],
  "notes": "Reference values computed with pandas; 122 rows survive sepal_total > 8.0."
}
