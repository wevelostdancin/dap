{
  "id": "wf-p6-time-series",
  "title": "Time series: decomposition, ACF, lags, drift forecast and ADF",
  "rationale": "Pins every mode of dap.time_series on the same 24-point series v(t) = 10 + 0.5 t + season(t mod 4), season = [0, 2, 0, -2]: the additive decomposition (exact linear trend and seasonal indices), the ACF/PACF at lags 0..4, the lag columns, the drift forecast with its intervals, and the ADF stationarity row.",
  "kind": "native",
  "nodes": [
    {
      "id": "src",
      "type": "sql_query",
      "config": {
        "sql": "SELECT i AS t, CAST(10.0 + 0.5 * i + CASE WHEN i % 4 = 1 THEN 2.0 WHEN i % 4 = 3 THEN -2.0 ELSE 0.0 END AS DOUBLE) AS v FROM range(24) AS t(i)"
      }
    },
    {
      "id": "dec",
      "type": "time_series",
      "config": {
        "mode": "decompose",
        "time": "t",
        "value": "v",
        "period": 4,
        "method": "additive"
      }
    },
    {
      "id": "acf",
      "type": "time_series",
      "config": {
        "mode": "acf",
        "time": "t",
        "value": "v",
        "max_lag": 4
      }
    },
    {
      "id": "lag",
      "type": "time_series",
      "config": {
        "mode": "lag",
        "time": "t",
        "value": "v",
        "max_lag": 2
      }
    },
    {
      "id": "fc",
      "type": "time_series",
      "config": {
        "mode": "forecast",
        "time": "t",
        "value": "v",
        "method": "drift",
        "horizon": 3
      }
    },
    {
      "id": "st",
      "type": "time_series",
      "config": {
        "mode": "stationarity",
        "time": "t",
        "value": "v"
      }
    }
  ],
