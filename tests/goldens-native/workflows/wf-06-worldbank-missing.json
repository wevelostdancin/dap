{
  "id": "wf-06-worldbank-missing",
  "title": "World Bank: fill missing currency with a constant, count by income group",
  "rationale": "The only shipped dataset with real NULLs: constant replacement, column pruning, count aggregate.",
  "kind": "baseline",
  "nodes": [
    {
      "id": "src",
      "type": "table_source",
      "config": {
        "dataset": "WORLDBANK_COUNTRIES"
      }
    },
    {
      "id": "fix",
      "type": "missing_value",
      "config": {
        "rules": [
          {
            "column": "Currency Unit",
            "method": "constant",
            "value": "UNKNOWN"
          }
        ]
      }
    },
    {
      "id": "cols",
      "type": "column_filter",
      "config": {
        "exclude": [
          "Special Notes",
          "Alternative conversion factor",
          "Latest household survey",
          "Source of most recent Income and expenditure data",
          "Column30",
          "Table Name",
          "Long Name"
        ]
      }
    },
    {
      "id": "g",
      "type": "group_by",
      "config": {
        "keys": [
          "Income Group"
        ],
        "aggregations": [
          {
            "column": "Country Code",
            "fn": "count"
          }
        ]
      }
    },
    {
      "id": "sort",
      "type": "sorter",
      "config": {
        "keys": [
          {
            "column": "Count(Country Code)",
            "direction": "desc"
          },
          {
            "column": "Income Group",
            "direction": "asc"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "src",
      "to": "fix"
    },
    {
      "from": "fix",
      "to": "cols"
    },
    {
      "from": "cols",
      "to": "g"
    },
    {
      "from": "g",
      "to": "sort"
    }
  ],
  "checks": [
    {
      "node": "fix",
      "kind": "profile"
    },
    {
      "node": "fix",
      "kind": "table",
      "limit": 5,
      "order": "unordered"
    },
    {
      "node": "cols",
      "kind": "profile"
    },
    {
      "node": "sort",
      "kind": "table",
      "limit": 20,
      "order": "ordered"
    }
  ]
}
