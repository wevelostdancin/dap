{
  "id": "wf-p6-resample-test",
  "title": "Resample test: bootstrap intervals and a permutation test",
  "rationale": "Pins dap.resample_test end to end: the bootstrap mean of 1..10 with seed 42 (200 resamples), the bootstrap correlation of a perfect line (a degenerate-resample-safe exact 1), and the two-sided permutation p-value of two separated groups with seed 42.",
  "kind": "native",
  "nodes": [
    {
      "id": "mean_src",
      "type": "sql_query",
      "config": {
        "sql": "SELECT i + 1 AS x FROM range(10) AS t(i)"
      }
    },
    {
      "id": "corr_src",
      "type": "sql_query",
      "config": {
        "sql": "SELECT i + 1 AS x, 2.0 * (i + 1) + 1.0 AS y FROM range(10) AS t(i)"
      }
    },
    {
      "id": "perm_src",
      "type": "sql_query",
      "config": {
        "sql": "SELECT i + 1 AS v, 'a' AS g FROM range(5) AS t(i) UNION ALL SELECT i + 10 AS v, 'b' AS g FROM range(5) AS t(i)"
      }
    },
    {
      "id": "boot_mean",
      "type": "resample_test",
      "config": {
        "mode": "bootstrap",
        "statistic": "mean",
        "columns": [
          "x"
        ],
        "resamples": 200,
        "seed": 42
      }
    },
    {
      "id": "boot_corr",
      "type": "resample_test",
      "config": {
        "mode": "bootstrap",
        "statistic": "correlation",
        "columns": [
          "x",
          "y"
        ],
        "resamples": 100,
        "seed": 42
      }
    },
    {
      "id": "perm",
      "type": "resample_test",
      "config": {
        "mode": "permutation",
        "statistic": "difference_mean",
        "value": "v",
        "group": "g",
        "permutations": 200,
        "seed": 42
      }
    }
  ],
  "edges": [
    {
      "from": "mean_src",
      "to": "boot_mean"
    },
    {
      "from": "corr_src",
      "to": "boot_corr"
    },
    {
      "from": "perm_src",
      "to": "perm"
    }
  ],
  "checks": [
    {
      "node": "boot_mean",
      "kind": "expect",
      "rows": 1,
      "columns": [
        {
          "name": "statistic",
          "type": "String"
        },
        {
          "name": "estimate",
          "type": "Number (Float)"
        },
        {
          "name": "se",
          "type": "Number (Float)"
        },
        {
