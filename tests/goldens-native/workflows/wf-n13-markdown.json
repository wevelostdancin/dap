{
  "id": "wf-n13-markdown",
  "title": "N13: deterministic Markdown report over the P2 fixture",
  "rationale": "Pins the markdown_report node end to end: the report is written on run and the input table is passed through unchanged.",
  "kind": "native",
  "nodes": [
    {
      "id": "src",
      "type": "csv_reader",
      "config": {
        "dataset": "P2"
      }
    },
    {
      "id": "report",
      "type": "markdown_report",
      "config": {
        "file": "/tmp/dap-goldens/wf-n13-markdown.md",
        "title": "P2 report",
        "sections": [
          {
            "kind": "table",
            "title": "Rows",
            "columns": [
              "id",
              "name",
              "score",
              "category"
            ],
            "limit": 10
          },
          {
            "kind": "profile",
            "title": "Profile",
            "columns": [
              "id",
              "score"
            ]
          },
          {
            "kind": "text",
            "title": "Note",
            "text": "Generated by the native golden suite."
          },
          {
            "kind": "metrics",
            "title": "Metrics",
            "columns": [
              "score"
            ]
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "src",
      "to": "report"
    }
  ],
  "checks": [
    {
      "node": "report",
      "kind": "expect",
      "rows": 6,
      "columns": [
        {
          "name": "id",
          "type": "Number (Integer)"
        },
        {
          "name": "name",
          "type": "String"
        },
        {
          "name": "score",
          "type": "Number (Float)"
        },
        {
          "name": "category",
          "type": "String"
        }
      ],
      "data": [
        [
          1,
          "alpha",
          1,
          "A"
        ],
        [
          2,
          "beta",
          2,
          "B"
        ],
        [
          3,
          "gamma",
          3,
          "A"
        ],
        [
          4,
          "delta",
          4,
          "C"
        ],
        [
          3,
          "gamma",
          3,
          "A"
        ],
        [
          5,
          "epsilon",
          5,
          "B"
        ]
      ],
      "order": "ordered"
    }
  ],
  "notes": "The report file itself is checked by MarkdownReportExecutorTest; the golden pins the pass-through table and the end-to-end run."
}
