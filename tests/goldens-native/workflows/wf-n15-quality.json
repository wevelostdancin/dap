{
  "id": "wf-n15-quality",
  "title": "N15: data quality checks over the P2 fixture with a reference input",
  "rationale": "Pins data_quality end to end: seven check kinds, one combined scan, a reference input for the referential check and the long output contract.",
  "kind": "native",
  "nodes": [
    {
      "id": "src",
      "type": "csv_reader",
      "config": {
        "dataset": "P2"
      }
    },
    {
      "id": "ref_src",
      "type": "csv_reader",
      "config": {
        "dataset": "P2"
      }
    },
    {
      "id": "reference",
      "type": "row_filter",
      "config": {
        "where": [
          {
            "column": "id",
            "op": "le",
            "value": 3
          }
        ]
      }
    },
    {
      "id": "quality",
      "type": "data_quality",
      "config": {
        "fail_on": "never",
        "output": "long",
        "checks": [
          {
            "kind": "not_null",
            "column": "id"
          },
          {
            "kind": "unique",
            "column": "id"
          },
          {
            "kind": "range",
            "column": "score",
            "min": 0,
            "max": 4
          },
          {
            "kind": "pattern",
            "column": "name",
            "regex": "^[a-z]+$"
          },
          {
            "kind": "allowed_values",
            "column": "category",
            "values": [
              "A",
              "B",
              "C"
            ]
          },
          {
            "kind": "row_count",
            "min": 1,
            "max": 10
          },
          {
            "kind": "referential",
            "column": "id"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "src",
      "to": "quality"
    },
    {
      "from": "ref_src",
      "to": "reference"
    },
    {
      "from": "reference",
      "to": "quality",
      "toPort": 1
    }
  ],
  "checks": [
    {
      "node": "quality",
      "kind": "expect",
      "rows": 7,
      "columns": [
        {
          "name": "check",
          "type": "String"
        },
        {
          "name": "column",
          "type": "String"
        },
        {
          "name": "status",
          "type": "String"
        },
        {
          "name": "message",
          "type": "String"
        },
        {
          "name": "failed_rows",
          "type": "Number (Integer)"
        },
        {
          "name": "total_rows",
          "type": "Number (Integer)"
        }
      ],
      "data": [
        [
          "not_null",
          "id",
          "PASS",
          "ok",
          0,
          6
        ],
        [
          "unique",
          "id",
          "FAIL",
          "2 rows sharing a duplicated value",
          2,
          6
        ],
        [
          "range",
          "score",
          "FAIL",
          "1 row outside [0, 4]",
          1,
          6
        ],
        [
          "pattern",
          "name",
          "PASS",
          "ok",
          0,
          6
        ],
        [
          "allowed_values",
          "category",
          "PASS",
          "ok",
          0,
          6
        ],
        [
          "row_count",
          null,
          "PASS",
          "ok",
          0,
          6
        ],
        [
          "referential",
          "id",
          "FAIL",
          "2 rows missing from the reference table",
          2,
          6
        ]
      ],
      "order": "ordered"
    }
  ],
  "notes": "Reference input is P2 filtered to ids 1..3, so ids 4 and 5 fail the referential check."
}
