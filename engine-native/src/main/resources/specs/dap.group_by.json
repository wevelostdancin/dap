{
  "id": "dap.group_by",
  "name": "Group By",
  "category": "/Manipulation/Row/GroupBy",
  "type": "Manipulator",
  "contributor": "dap-native",
  "tier": "core",
  "deprecated": false,
  "available": true,
  "description": "Groups rows by key columns and computes aggregate values per group. Aggregate columns are named like Mean(age).",
  "inPorts": [
    {
      "index": 0,
      "name": "Data",
      "type": "BufferedDataTable"
    }
  ],
  "outPorts": [
    {
      "index": 0,
      "name": "Data",
      "type": "BufferedDataTable"
    }
  ],
  "configSchema": {
    "type": "object",
    "title": "Group By configuration",
    "additionalProperties": false,
    "properties": {
      "keys": {
        "type": "array",
        "title": "Group keys",
        "description": "Input columns to group by.",
        "items": {
          "type": "string"
        }
      },
      "aggregations": {
        "type": "array",
        "title": "Aggregations",
        "description": "Aggregate expressions computed per group; output columns are named like Mean(age).",
        "items": {
          "type": "object",
          "title": "Aggregation",
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string",
              "title": "Column",
              "description": "Input column to aggregate."
            },
            "fn": {
              "type": "string",
              "title": "Function",
              "description": "Aggregate function.",
              "enum": [
                "mean",
                "sum",
                "count",
                "min",
                "max"
              ]
            }
          },
          "required": [
            "column",
            "fn"
          ]
        }
      }
    },
    "required": [
      "keys",
      "aggregations"
    ]
  }
}
