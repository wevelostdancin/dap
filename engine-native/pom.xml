<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dap</groupId>
  <artifactId>dap-native</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>dap-native</name>
  <description>Native analytics engine for DAP: Javalin + DuckDB + Arrow, /v1 compatible.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javalin.version>6.7.0</javalin.version>
    <duckdb.version>1.5.6.0</duckdb.version>
    <arrow.version>19.0.0</arrow.version>
    <jackson.version>2.21.6</jackson.version>
    <junit.version>5.11.4</junit.version>
    <!-- Default JUnit tag filter: the slow soak suite runs via "make soak"
         (./mvnw -q -Dgroups=soak test), everything else runs in the normal suite. -->
    <groups>!soak</groups>
    <!-- Extra JVM flags for one-off bounded-heap runs, e.g. -Ddap.test.jvmargs=-Xmx256m. -->
    <dap.test.jvmargs></dap.test.jvmargs>
    <!-- The shaded jar keeps one platform's duckdb_jdbc native library. Each of these
         properties holds the file to exclude, so a profile hides the build host's own
         library behind a sentinel pattern; -Ddap.duckdb.native=all|osx_universal|
         linux_amd64|linux_arm64|windows_amd64 overrides the host default. -->
    <dap.duckdb.keep>__dap_keep_native__</dap.duckdb.keep>
    <dap.duckdb.native.osx_universal>libduckdb_java.so_osx_universal</dap.duckdb.native.osx_universal>
    <dap.duckdb.native.linux_amd64>libduckdb_java.so_linux_amd64</dap.duckdb.native.linux_amd64>
    <dap.duckdb.native.linux_arm64>libduckdb_java.so_linux_arm64</dap.duckdb.native.linux_arm64>
    <dap.duckdb.native.windows_amd64>libduckdb_java.so_windows_amd64</dap.duckdb.native.windows_amd64>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>${javalin.version}</version>
    </dependency>
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>${duckdb.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.17</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.5.18</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>dap-native</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <groups>${groups}</groups>
          <argLine>${dap.test.jvmargs} --add-opens=java.base/java.nio=ALL-UNNAMED -Djava.awt.headless=true</argLine>
          <systemPropertyVariables>
            <dap.project.root>${project.basedir}/..</dap.project.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.duckdb:duckdb_jdbc</artifact>
                  <excludes>
                    <exclude>**/${dap.duckdb.native.osx_universal}</exclude>
                    <exclude>**/${dap.duckdb.native.linux_amd64}</exclude>
                    <exclude>**/${dap.duckdb.native.linux_arm64}</exclude>
                    <exclude>**/${dap.duckdb.native.windows_amd64}</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.dap.nativeengine.NativeService</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Host defaults: keep the native library of the machine that runs the build.
         The host profile is disabled as soon as -Ddap.duckdb.native is given. -->
    <profile>
      <id>duckdb-native-host-macos</id>
      <activation>
        <os><family>mac</family></os>
        <property><name>!dap.duckdb.native</name></property>
      </activation>
      <properties>
        <dap.duckdb.native.osx_universal>${dap.duckdb.keep}</dap.duckdb.native.osx_universal>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-host-linux-amd64</id>
      <activation>
        <os><name>Linux</name><arch>amd64</arch></os>
        <property><name>!dap.duckdb.native</name></property>
      </activation>
      <properties>
        <dap.duckdb.native.linux_amd64>${dap.duckdb.keep}</dap.duckdb.native.linux_amd64>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-host-linux-arm64</id>
      <activation>
        <os><name>Linux</name><arch>arm64</arch></os>
        <property><name>!dap.duckdb.native</name></property>
      </activation>
      <properties>
        <dap.duckdb.native.linux_arm64>${dap.duckdb.keep}</dap.duckdb.native.linux_arm64>
      </properties>
    </profile>
    <!-- The JVM on Linux aarch64 reports os.arch=aarch64, and Maven's <os><arch> match is a
         literal comparison, so the arm64 profile above alone would not activate. -->
    <profile>
      <id>duckdb-native-host-linux-aarch64</id>
      <activation>
        <os><name>Linux</name><arch>aarch64</arch></os>
        <property><name>!dap.duckdb.native</name></property>
      </activation>
      <properties>
        <dap.duckdb.native.linux_arm64>${dap.duckdb.keep}</dap.duckdb.native.linux_arm64>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-host-windows-amd64</id>
      <activation>
        <os><family>windows</family><arch>amd64</arch></os>
        <property><name>!dap.duckdb.native</name></property>
      </activation>
      <properties>
        <dap.duckdb.native.windows_amd64>${dap.duckdb.keep}</dap.duckdb.native.windows_amd64>
      </properties>
    </profile>

    <!-- Explicit cross-platform packaging: -Ddap.duckdb.native=all|osx_universal|
         linux_amd64|linux_arm64|windows_amd64. -->
    <profile>
      <id>duckdb-native-all</id>
      <activation>
        <property><name>dap.duckdb.native</name><value>all</value></property>
      </activation>
      <properties>
        <dap.duckdb.native.osx_universal>${dap.duckdb.keep}</dap.duckdb.native.osx_universal>
        <dap.duckdb.native.linux_amd64>${dap.duckdb.keep}</dap.duckdb.native.linux_amd64>
        <dap.duckdb.native.linux_arm64>${dap.duckdb.keep}</dap.duckdb.native.linux_arm64>
        <dap.duckdb.native.windows_amd64>${dap.duckdb.keep}</dap.duckdb.native.windows_amd64>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-osx-universal</id>
      <activation>
        <property><name>dap.duckdb.native</name><value>osx_universal</value></property>
      </activation>
      <properties>
        <dap.duckdb.native.osx_universal>${dap.duckdb.keep}</dap.duckdb.native.osx_universal>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-linux-amd64</id>
      <activation>
        <property><name>dap.duckdb.native</name><value>linux_amd64</value></property>
      </activation>
      <properties>
        <dap.duckdb.native.linux_amd64>${dap.duckdb.keep}</dap.duckdb.native.linux_amd64>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-linux-arm64</id>
      <activation>
        <property><name>dap.duckdb.native</name><value>linux_arm64</value></property>
      </activation>
      <properties>
        <dap.duckdb.native.linux_arm64>${dap.duckdb.keep}</dap.duckdb.native.linux_arm64>
      </properties>
    </profile>
    <profile>
      <id>duckdb-native-windows-amd64</id>
      <activation>
        <property><name>dap.duckdb.native</name><value>windows_amd64</value></property>
      </activation>
      <properties>
        <dap.duckdb.native.windows_amd64>${dap.duckdb.keep}</dap.duckdb.native.windows_amd64>
      </properties>
    </profile>
  </profiles>
</project>
