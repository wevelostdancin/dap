# VCS / IDE / macOS
.git
.gitignore
.gitattributes
**/.DS_Store

# Состояние запущенного сервиса и артефакты сборки
workspace/
build/classes/
build/*.tar
build/*.oci
*.log

# Не нужны в образе
tests/
docs/

# Python-кэш (gen-bundles-info.py запускается только при сборке)
**/__pycache__/
**/*.pyc

# Большой отчёт-артефакт; catalog/schemas нужны и остаются в образе
catalog/schema-report.json
